[Unit]
Description=Medical Suifang API
After=network.target

[Service]
Type=simple
User=suifang
WorkingDirectory=/home/suifang/medical_suifang
EnvironmentFile=/etc/medical_suifang.env
ExecStart=/home/suifang/.venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
